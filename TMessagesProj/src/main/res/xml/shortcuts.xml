<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick_ghost_mode"
        android:enabled="true"
        android:icon="@drawable/shortcut_ghost_mode"
        android:shortcutShortLabel="@string/GhostMode"
        android:shortcutLongLabel="@string/GhostMode">
        <intent
            android:action="app.exteraless.action.TOGGLE_GHOST_MODE"
            android:targetPackage="com.exteraless.app"
            android:targetClass="app.exteraless.shortcuts.QuickToggleActivity" />
    </shortcut>

    <shortcut
        android:shortcutId="quick_safe_mode"
        android:enabled="true"
        android:icon="@drawable/shortcut_safe_mode"
        android:shortcutShortLabel="@string/PluginsSafeMode"
        android:shortcutLongLabel="@string/PluginsSafeMode">
        <intent
            android:action="app.exteraless.action.TOGGLE_SAFE_MODE"
            android:targetPackage="com.exteraless.app"
            android:targetClass="app.exteraless.shortcuts.QuickToggleActivity" />
    </shortcut>

    <share-target android:targetClass="org.telegram.ui.LaunchActivity">
        <data android:mimeType="*/*" />
        <category android:name="org.telegram.messenger.SHORTCUT_SHARE" />
    </share-target>

    <capability android:name="actions.intent.GET_THING">
        <intent>
            <url-template android:value="tg://search{?query}" />
            <parameter
                android:name="thing.name"
                android:key="query"
                android:required="true" />
        </intent>
        <intent>
            <url-template android:value="tg://search" />
        </intent>
    </capability>
    <capability android:name="actions.intent.CREATE_CALL">
        <intent>
            <url-template android:value="tg://call{?format,name,phone}" />
            <parameter
                android:name="call.callFormat"
                android:key="format" />
            <parameter
                android:name="call.participant.name"
                android:key="name" />
            <parameter
                android:name="call.participant.telephone"
                android:key="phone" />
        </intent>
    </capability>
    <capability android:name="actions.intent.GET_ACCOUNT">
        <intent>
            <url-template android:value="tg://settings" />
        </intent>
    </capability>
    <capability android:name="actions.intent.GET_BARCODE">
        <intent>
            <url-template android:value="tg://scanqr" />
        </intent>
    </capability>
    <capability android:name="actions.intent.GET_CALL">
        <intent>
            <url-template android:value="tg://calllog" />
        </intent>
    </capability>
</shortcuts>